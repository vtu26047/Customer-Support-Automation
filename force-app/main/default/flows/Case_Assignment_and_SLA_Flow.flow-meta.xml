                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_General_Support_Queue</targetReference>
            </connector>
            <label>Medium Priority</label>
        </rules>
        <rules>
            <name>Low_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Low</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_General_Support_Queue_Low</targetReference>
            </connector>
            <label>Low Priority</label>
        </rules>
    </decisions>
